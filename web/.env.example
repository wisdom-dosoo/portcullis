# Portcullis Web Frontend
# Copy this file to .env.local and fill in the values.

# The base URL of the Portcullis API backend (required)
NEXT_PUBLIC_API_URL=http://localhost:8080
# SSO slug for the "Continue with Google" button (must match backend SSO_OIDC_SLUG)
NEXT_PUBLIC_SSO_SLUG=google
# Clerk authentication (Dashboard -> API Keys -> Publishable key)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# Clerk routing: our /login and /register pages host the Clerk components
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
