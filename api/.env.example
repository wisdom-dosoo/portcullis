DATABASE_URL=postgresql+asyncpg://portcullis:portcullis@localhost:5432/portcullis
REDIS_URL=redis://localhost:6379/0
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Production refuses to boot with this value (see config.reject_insecure_production_pepper).
API_KEY_PEPPER=development-only-change-me
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=*
UPSTREAM_ALLOWED_HOSTS=localhost,127.0.0.1
UPSTREAM_CONNECT_TIMEOUT_SECONDS=5
UPSTREAM_READ_TIMEOUT_SECONDS=30
HEALTH_CHECK_INTERVAL_SECONDS=30
HEALTH_CHECK_FAILURE_THRESHOLD=3
RATE_LIMIT_DEFAULT=100/minute
AUTH_RATE_LIMIT_DEFAULT=20/minute

# --- Render free-tier (production) — copy to Render Dashboard, not .env ---
# Neon pooled for app (port 6543) + direct for migrations (port 5432):
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.aws.neon.tech:6543/portcullis?sslmode=require
# DATABASE_URL_DIRECT=postgresql+asyncpg://user:pass@ep-xxx.aws.neon.tech:5432/portcullis?sslmode=require
# DB_PGBOUNCER=true
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# Upstash Redis:
# REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379/0
# Production hardening (required — boot fails without them):
# CORS_ALLOWED_ORIGINS=https://portcullis.pages.dev,https://app.yourdomain.com
# MCP_ALLOWED_ORIGINS=https://claude.ai,https://cursor.sh,https://portcullis.pages.dev
# FORWARDED_ALLOW_IPS=<render+cloudflare CIDRs, never *>
# Clerk (identity layer: signup/login/Google OAuth + JWT validation):
# JWT_JWKS_URL=https://<clerk-frontend-api>/.well-known/jwks.json
# JWT_ISSUER=https://<clerk-frontend-api>
# Leave JWT_AUDIENCE empty for Clerk's default session tokens (no aud claim);
# set it only with a custom Clerk JWT template that includes the audience.
# JWT_AUDIENCE=
# Clerk Backend API key (Dashboard -> API Keys -> Secret key) — lets
# POST /auth/clerk/sync resolve the verified primary email. Without it,
# sync falls back to the token's `email` claim (custom JWT template only).
# CLERK_SECRET_KEY=sk_test_...
# Resend (100/day free) — powers invitation emails (POST /auth/invites):
# EMAIL_PROVIDER=resend
# EMAIL_FROM=noreply@yourdomain.com
# EMAIL_FROM_NAME=Portcullis
# RESEND_API_KEY=re_xxx
# Render injects PORT automatically — entrypoint.sh uses ${PORT:-8080}.
# Health check path in render.yaml is /livez (liveness); /healthz stays deep readiness.
# --- Continue with Google (OIDC SSO) — defaults in app/config.py already point at Google ---
# SSO_ENABLED=true
# SSO_OIDC_SLUG=google
# SSO_OIDC_CLIENT_ID=<google-cloud-oauth-client-id>.apps.googleusercontent.com
# SSO_OIDC_CLIENT_SECRET=<google-cloud-oauth-client-secret>
# SSO_PUBLIC_BASE_URL=http://localhost:8000
# Authorized redirect URI to register in Google Cloud Console:
# http://localhost:8000/auth/sso/google/callback
